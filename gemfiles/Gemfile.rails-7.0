source 'https://rubygems.org'
git_source(:github) { |repo| "https://github.com/#{repo}.git" }

gemspec path: '..'

group :development do
  gem 'bundler', '>= 2.0', require: false
  gem 'simplecov', '~> 0.22.0', require: false
end

group :test do
  gem "activerecord-jdbcsqlite3-adapter", platforms: [:jruby]

  platforms :ruby do
    gem 'sqlite3', '~> 1.4'
  end

  gem 'actionmailer', '~> 7.0.0'
  gem 'activerecord', '~> 7.0.0'
  gem 'capybara'
  gem 'devise', '~> 5.0'
  # Active Support's JSON encoder passes quirks_mode, which JSON 3 removed.
  gem 'json', '< 3'
  gem 'minitest', '< 6'
  gem 'mocha'
  gem 'mongoid'
  gem 'nokogiri'
  gem 'rspec-rails'
  gem 'shoulda'
  gem 'concurrent-ruby', '< 1.3.5'

  # For Ruby 3.4
  gem 'bigdecimal'
  gem 'drb'
  gem 'mutex_m'
end
